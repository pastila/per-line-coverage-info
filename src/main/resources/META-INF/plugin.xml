<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin url="https://yakov255.github.io/per-line-coverage-info/updatePlugins.xml">
    <id>com.github.yakov255.perlinecoverageinfo</id>
    <name>Per-Line Coverage Info</name>
    <vendor>yakov255</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="mcp-integration.xml">com.intellij.mcpServer</depends>
    <depends>com.jetbrains.php</depends>
    <depends>gherkin</depends>
    <depends optional="true" config-file="behat-integration.xml">com.jetbrains.php.behat</depends>
    <depends optional="true" config-file="git-integration.xml">Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <updateSettingsProvider implementation="com.github.yakov255.perlinecoverageinfo.CustomRepoProvider"/>
        <errorHandler
            implementation="com.github.yakov255.perlinecoverageinfo.CoverageErrorReporter"/>
        <projectService
            serviceImplementation="com.github.yakov255.perlinecoverageinfo.LineMappingService"/>
        <projectService
            serviceImplementation="com.github.yakov255.perlinecoverageinfo.CoverageGutterVisibilityService"/>
        <projectService
            serviceImplementation="com.github.yakov255.perlinecoverageinfo.CoverageUserSelectionService"/>
        <projectService
            serviceImplementation="com.github.yakov255.perlinecoverageinfo.CoverageLoadService"/>
        <projectService
            serviceImplementation="com.github.yakov255.perlinecoverageinfo.CoverageCacheService"/>
        <projectService
            serviceImplementation="com.github.yakov255.perlinecoverageinfo.AffectedTestsService"/>
        <applicationConfigurable
            parentId="tools"
            instance="com.github.yakov255.perlinecoverageinfo.CoverageApiSettingsConfigurable"
            id="coverage.api.settings"
            displayName="GitLab Coverage"/>
        <editorFactoryListener
            implementation="com.github.yakov255.perlinecoverageinfo.CoverageEditorListener"/>
        <toolWindow id="Coverage Tests"
                    anchor="bottom"
                    factoryClass="com.github.yakov255.perlinecoverageinfo.CoverageTestsToolWindowFactory"
                    secondary="false"
                    icon="AllIcons.Toolwindows.ToolWindowCoverage"/>
        <notificationGroup id="Coverage Notifications"
                           displayType="BALLOON"
                           bundle="messages.CoverageBundle"
                           key="notification.group.coverage"/>
        <postStartupActivity
            implementation="com.github.yakov255.perlinecoverageinfo.CoverageStartupActivity"/>
    </extensions>


    <actions>
        <action id="LoadCoverageFromGitLab" class="com.github.yakov255.perlinecoverageinfo.LoadCoverageAction"
                text="Load Coverage from GitLab" description="Download coverage artifacts from GitLab and display per-line coverage">
        </action>
        <action id="LoadLocalCoverage" class="com.github.yakov255.perlinecoverageinfo.LoadLocalCoverageAction"
                text="Load Coverage from File" description="Merge per-line coverage from a local .covt file over CI coverage">
        </action>
        <action id="CollectLocalCoverage" class="com.github.yakov255.perlinecoverageinfo.CollectLocalCoverageToggleAction"
                icon="AllIcons.General.RunWithCoverage"
                text="Collect Local Coverage" description="Make Behat runs started from the IDE write coverage that is merged over CI coverage">
        </action>
        <action id="ClearLocalCoverage" class="com.github.yakov255.perlinecoverageinfo.ClearLocalCoverageAction"
                text="Clear Local Coverage" description="Drop coverage from local runs and show CI coverage only">
        </action>
        <action id="ClearCoverageData" class="com.github.yakov255.perlinecoverageinfo.ClearCoverageAction"
                text="Clear Coverage Data" description="Remove coverage annotations from all editors">
        </action>
        <action id="HideCoverageFromGutter" class="com.github.yakov255.perlinecoverageinfo.HideCoverageGutterAction"
                text="Hide Coverage" description="Hide coverage annotations from all editors">
            <add-to-group group-id="EditorGutterPopupMenu" anchor="after" relative-to-action="EditorGutterVcsPopupMenu"/>
        </action>
        <action id="ShowCoverageInGutter" class="com.github.yakov255.perlinecoverageinfo.ShowCoverageGutterAction"
                text="Show Coverage" description="Show coverage annotations in all editors">
            <add-to-group group-id="EditorGutterPopupMenu" anchor="after" relative-to-action="HideCoverageFromGutter"/>
        </action>
    </actions>
</idea-plugin>
